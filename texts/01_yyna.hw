// 洄文范文 一 · 雨夜（yy4 · po4）
// 三句 = 三张图。演示：临弓填槽（甲/戊/己/乙）、饰弓限定、结际弓、三种义标。

.graph 第一句 · 雨落
@0 yy4.体          // 雨      自然 i=318
@1 pe2.用          // 落      运动 i=113
@2 po4.体          // 夜      自然 i=323
@3 ya2.貌          // 静      运动 i=104
@4 ye4.体          // 地      自然 i=313
@1 -> 0            // 落，其主体是「雨」      （甲位，按槽表首填）
@1 -戊-> 2         // 落，其时段是「夜」      （戊位，显式）
@1 -己-> 4         // 落，其归向是「地」      （己位）
@3 => 2            // 静，限定「夜」          （饰弓 = 「之」）
#see               // 义标：亲见

.graph 第二句 · 我不能睡
@0 tu2.体          // 睡      身体 i=133
@1 yi6.体          // 我      虚词 i=386
@2 lv.用           // 停      运动 i=103
@3 pe4.体          // 月      自然 i=321
@2 -> 0            // 停，其主体是「睡」
@1 -乙-> 0         // 睡，其客体是「我」
@2 -乙-> 3         // 停，其客体是「月」——睡的停止，因月而起
~                  // 否定模态：不
#felt              // 义标：亲身感受

.graph 第三句 · 我忆月
@0 gy2.用          // 回忆    心灵 i=158
@1 yi6.体          // 我
@2 pe4.体          // 月      自然 i=321
@0 -> 1            // 回忆，其主体是「我」
@0 -庚-> 2         // 回忆，其内容是「月」
[ @3 pe4.体
  @4 du3.体
  @3 -乙-> 4 ] !> @0    // 「月之光」——是回忆所要达成的事（目的弓 !>）
#see               // 义标：亲见
