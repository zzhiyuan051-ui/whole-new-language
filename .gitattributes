# ---------------------------------------------------------------
# 洄文 · 换行符与文本属性
#
# 起因：Windows 上 git 默认 core.autocrlf=true，会把工作区的 LF 换成 CRLF，
# 于是每次 `git status` 都冒出
#     warning: LF will be replaced by CRLF the next time Git touches it
# 并制造无内容的 diff。这里统一为 LF，让任何平台 clone 下来都一致。
# ---------------------------------------------------------------

# 默认：按内容自动判定文本，检出一律 LF
* text=auto eol=lf

# ---- 明确是文本，且必须是 LF ----
*.py     text eol=lf
*.md     text eol=lf
*.tsv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.hw     text eol=lf
*.ps1    text eol=lf
*.bat    text eol=lf
*.def    text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.rpy    text eol=lf

# ---- 二进制：禁止任何换行符转换（否则文件会被 git 弄坏）----
*.ttf    binary
*.otf    binary
*.ttc    binary
*.woff   binary
*.woff2  binary
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.docx   binary
*.exe    binary
*.dll    binary
*.obj    binary
*.lib    binary
*.exp    binary

# ---- 让 git 在 diff/language 统计里认得出这些扩展名 ----
*.py     diff=python
*.md     diff=markdown
*.tsv    diff=csv
